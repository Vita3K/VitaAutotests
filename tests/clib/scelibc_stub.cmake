# Builds a copy of the SceLibc stubs for the given functions, each renamed to scelibc_<name>, so a test
# can call SceLibc's qsort or sin next to newlib's. A stub's import comes from its NIDs, not its name.
#   cmake -DAR=... -DOBJCOPY=... -DLIB=libSceLibc_stub.a -DOUT=out.a -DDIR=work -DFUNCS="qsort;sin" -P scelibc_stub.cmake
file(REMOVE_RECURSE ${DIR})
file(MAKE_DIRECTORY ${DIR})
execute_process(COMMAND ${AR} t ${LIB} OUTPUT_VARIABLE members COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" members "${members}")
set(objects "")
foreach(func ${FUNCS})
	set(member "")
	foreach(m ${members})
		if(m MATCHES "^SceLibc_SceLib[cm]_${func}\\.o$")
			set(member ${m})
		endif()
	endforeach()
	if(NOT member)
		message(FATAL_ERROR "No SceLibc stub for ${func}")
	endif()
	execute_process(COMMAND ${AR} x ${LIB} ${member} WORKING_DIRECTORY ${DIR} COMMAND_ERROR_IS_FATAL ANY)
	execute_process(COMMAND ${OBJCOPY} --redefine-sym ${func}=scelibc_${func} ${member} WORKING_DIRECTORY ${DIR} COMMAND_ERROR_IS_FATAL ANY)
	list(APPEND objects ${member})
endforeach()
file(REMOVE ${OUT})
execute_process(COMMAND ${AR} rcs ${OUT} ${objects} WORKING_DIRECTORY ${DIR} COMMAND_ERROR_IS_FATAL ANY)
